+    def _mimo_prefill_flashinfer(self, q, o, layer, forward_batch, kv_indptr, kv_indices, k_scale, v_scale):
+        """FA2 paged prefill over prefix + fresh tokens already written to the FP8 cache.
+
+        Planned once per forward batch and shared by all full-attention layers.
+        Returns False (caller falls back to Triton) if planning fails.
+        """
+        try:
+            import itertools
+
+            import flashinfer
+            from sglang.kernels.ops.attention.extend_attention import build_unified_kv_indices
+
+            key = id(forward_batch)
+            if self.mimo_fi_plan_key != key:
+                if self.mimo_fi_wrapper is None:
+                    self.mimo_fi_wrapper = flashinfer.BatchPrefillWithPagedKVCacheWrapper(
+                        torch.empty(512 << 20, dtype=torch.uint8, device=self.device), "NHD"
+                    )
+                bs = forward_batch.batch_size
+                new_loc = (
+                    self.forward_metadata.out_cache_loc_full_physical
+                    if self.forward_metadata.out_cache_loc_full_physical is not None
+                    else forward_batch.out_cache_loc
+                )
+                unified_indptr, unified_indices, _ = build_unified_kv_indices(
+                    kv_indptr, kv_indices, forward_batch.extend_start_loc,
+                    forward_batch.extend_seq_lens, new_loc, bs,
+                )
+                # Host indptrs from the batch's CPU lengths: the shared GPU qo_indptr buffer
+                # can already hold a later batch's metadata (overlap scheduling, verify
+                # graphs) when plan() copies it to the host.
+                ext_cpu = list(forward_batch.extend_seq_lens_cpu)
+                pre_cpu = list(forward_batch.extend_prefix_lens_cpu)
+                qo_cpu = torch.tensor([0] + list(itertools.accumulate(ext_cpu)), dtype=torch.int32)
+                kv_cpu = torch.tensor(
+                    [0] + list(itertools.accumulate(p + e for p, e in zip(pre_cpu, ext_cpu))),
+                    dtype=torch.int32,
+                )
+                self.mimo_fi_wrapper.plan(
+                    qo_cpu, kv_cpu,
+                    unified_indices.to(torch.int32), torch.ones(bs, dtype=torch.int32, device=self.device),
+                    32, 2, 192, 1, head_dim_vo=128, causal=True, sm_scale=layer.scaling,
+                    q_data_type=torch.bfloat16, kv_data_type=torch.float8_e4m3fn, o_data_type=torch.bfloat16,
+                )
+                self.mimo_fi_plan_key = key
+            k_buf = self.token_to_kv_pool.get_key_buffer(layer.layer_id)
+            v_buf = self.token_to_kv_pool.get_value_buffer(layer.layer_id)
+            # The token batch can be padded past the real extend tokens; FlashInfer
+            # needs exactly qo_indptr[-1] rows, padded rows stay untouched.
+            total = sum(forward_batch.extend_seq_lens_cpu)
+            out = self.mimo_fi_wrapper.run(
+                q.view(-1, 32, 192)[:total], (k_buf.view(-1, 1, 2, 192), v_buf.view(-1, 1, 2, 128)),
+                k_scale=k_scale, v_scale=v_scale,
+            )
+            o.view(-1, 32, 128)[:total].copy_(out)
+            if not self.mimo_prefill_announced:
+                print("MIMO_PREFILL_GROUPED_DISPATCH flashinfer-fa2", flush=True)
+                self.mimo_prefill_announced = True
+            return True
+        except Exception as exc:  # this batch falls back to Triton; log each distinct error once
+            msg = f"{type(exc).__name__}: {exc}"
+            if msg not in self.mimo_fi_errors:
+                self.mimo_fi_errors.add(msg)
+                print(f"MIMO_PREFILL_FLASHINFER_FALLBACK {msg}", flush=True)
+            self.mimo_fi_plan_key = None
+            return False
+
+    def _prepare_mimo_cuda_verify(self, bs, width):
+        if not self.mimo_cuda_verify_enabled or width not in (3, 4, 5, 6, 8):
+            return None
+        key = (bs, width)
+        if key not in self.mimo_cuda_verify_cache:
+            if torch.cuda.is_current_stream_capturing():
+                return None
+            from sglang.srt.layers.attention.mimo_cuda_verify import FullVerifyExperiment, LayoutReceipt
+            # TARGET_VERIFY builders create uniform arange qo_indptr.
+            # Topk1 scheduler guarantees a causal chain with committed prefix.
+            layout = LayoutReceipt(bs, width, True, True, True, self.page_size)
+            self.mimo_cuda_verify_cache[key] = FullVerifyExperiment(
+                layout, variant="grouped", splits=32, block_h=16,
+                block_n=64, warps=4, device=self.device,
+            )
+        return self.mimo_cuda_verify_cache[key]
+
